DATABASE_URL=postgresql://postgres:password@localhost:5432/shorts_dev
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

JWT_SECRET=change-in-prod-min-64-chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=32-byte-hex-key-for-aes-256

YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=from-google-cloud-console
YOUTUBE_CLIENT_SECRET=from-google-cloud-console
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/auth/youtube/callback

S3_BUCKET=shorts-dev
S3_ENDPOINT=https://{accountId}.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

OPENAI_API_KEY=

FRONTEND_URL=http://localhost:3000
PORT=3001
API_INTERNAL_SECRET=shared-secret-for-worker-callbacks

# Stripe billing
# Fill in with Stripe test-mode values:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_CREATOR=price_...
# STRIPE_PRICE_AGENCY=price_...

# PR 7 — Notifications (§15). Email via Resend's HTTP API (no SDK dep
# needed — EmailService uses plain fetch). Leave RESEND_API_KEY unset in
# dev: emails are logged instead of sent, so the pipeline works without
# an account. Slack delivery reuses Organization.webhookUrl (per-org, set
# via /settings), not an env var.
RESEND_API_KEY=re_g9SdkUCu_7pKeg2y1mKxgCMjX6L6xdiKj
EMAIL_FROM=notifications@shorts.dev
# Debounce window for the batched "Shorts ready for review" email (§15.1:
# max 1 email/hour) — default 15 min so a burst of renders coalesces into
# one notification without making early testers wait a full hour to see it.
NOTIFICATIONS_BATCH_WINDOW_MS=900000

# Python worker base URLs — used by the BullMQ dispatch processors
CLIP_WORKER_URL=http://localhost:8002
TRANSCRIPTION_WORKER_URL=http://localhost:8001
RENDER_WORKER_URL=http://localhost:8003
PUBLISH_WORKER_URL=http://localhost:8004
